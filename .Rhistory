) %>%
group_by(statut_tabac) %>%
mutate(pct = round(100 * n / sum(n), 1)) %>%
ungroup() %>%
mutate(endroit = factor(endroit, levels = labels_endroits))
tab_global_tabac
# selon le CAMPUS
tab_campus = df_long %>%
filter(coche == TRUE) %>%
count(campus, endroit) %>%
complete(
campus = campus_levels,
endroit = labels_endroits,
fill = list(n = 0)
) %>%
group_by(campus) %>%
mutate(pct = round(100 * n / sum(n), 1)) %>%
ungroup() %>%
mutate(endroit = factor(endroit, levels = labels_endroits))
tab_campus
# CAMPUS + GENRE
tab_campus_genre = df_long %>%
filter(coche == TRUE) %>%
count(campus, endroit, genre) %>%
complete(
campus = campus_levels,
endroit = labels_endroits,
