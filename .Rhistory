tab_campus_genre
# CAMPUS + TABAC
tab_campus_tabac = df_long %>%
filter(coche == TRUE) %>%
count(campus, endroit, statut_tabac) %>%
complete(
campus = campus_levels,
endroit = labels_endroits,
