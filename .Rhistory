library(readxl);library(janitor);library(dplyr);library(tidyr)
library(stringr);library(ggplot2);library(scales);library(tibble)
#deces
var_deces = "savez_vous_combien_de_personnes_decedent_prematurement_du_tabac_tous_les_ans_en_france"
campus_order = c("UNICAEN", "IFRES", "ISPA")
donnees_brutes = read_excel("Alençon_Résultats-données-brutes.xlsx") %>% clean_names()
donnees = donnees_brutes[, -c(1, 2, 3, 4, 5, 37, 51, 52, 55)] %>%
mutate(
quel_est_votre_etablissement_de_rattachement = recode(
quel_est_votre_etablissement_de_rattachement,
"Université de Caen Normandie (IUT, Antenne de droit, INSPE)" = "UNICAEN"
),
vous_arrive_t_il_de_fumer = recode(
vous_arrive_t_il_de_fumer,
"Oui, je fume de temps en temps (mais pas tous les jours)" = "Oui, de temps en temps"
))
donnees_a = donnees %>%filter(
!is.na(quel_est_votre_etablissement_de_rattachement),
quel_est_votre_etablissement_de_rattachement != "N/A"
) %>%
mutate(
campus = str_squish(as.character(quel_est_votre_etablissement_de_rattachement)))
#  GENRE
donnees_a = donnees_a %>%
mutate(
genre = case_when(
str_detect(str_to_lower(etes_vous), "femme") ~ "Femme",
str_detect(str_to_lower(etes_vous), "homme") ~ "Homme",
str_detect(str_to_lower(etes_vous), "ne souhaite") ~ "NSP",
TRUE ~ NA_character_
),
genre = factor(genre, levels = c("Femme", "Homme", "NSP")))
# STATUT TABAGIQUE
donnees_a = donnees_a %>%
mutate(
fume_maintenant = case_when(
str_detect(str_to_lower(vous_arrive_t_il_de_fumer), "^oui") ~ TRUE,
str_detect(str_to_lower(vous_arrive_t_il_de_fumer), "^non") ~ FALSE,
TRUE ~ NA
),
a_deja_fume = case_when(
avez_vous_deja_fume == "Oui" ~ TRUE,
avez_vous_deja_fume == "Non" ~ FALSE,
TRUE ~ NA
),
statut_tabac = case_when(
fume_maintenant == TRUE ~ "Fumeur",
fume_maintenant == FALSE & a_deja_fume == TRUE ~ "Ex-fumeur",
fume_maintenant == FALSE & a_deja_fume == FALSE ~ "Non-fumeur",
TRUE ~ NA_character_
),
statut_tabac = factor(statut_tabac, levels = c("Fumeur", "Non-fumeur", "Ex-fumeur")))
#STATUT (Etudiants vs Personnels)
donnees_a = donnees_a %>%
mutate(
statut_source = case_when(
campus == "UNICAEN" ~ as.character(quel_est_votre_statut),
TRUE ~ as.character(quel_est_votre_statut_au_sein_de_linstitut)
),
statut_low = str_to_lower(statut_source),
statut_2 = case_when(
str_detect(statut_low, "etudiant|Etudiant|doctorant|apprenant|alternant|apprentissage") ~ "Etudiants",
str_detect(statut_low, "personnel|professionnel|administratif|technique|enseignant|chercheur") ~ "Personnels",
str_detect(statut_low, "^autre") ~ "Personnels",
TRUE ~ NA_character_
),
statut_2 = factor(statut_2, levels = c("Etudiants", "Personnels"))
)
#PREPARATION DES REPONSES DECES
base_deces = donnees_a %>%
filter(
!is.na(.data[[var_deces]]),
.data[[var_deces]] != "N/A"
) %>%
mutate(
reponse_deces = str_squish(as.character(.data[[var_deces]])))
reponse_order = c("30 000 personnes", "60 000 personnes", "75 000 personnes", "Je ne sais pas")
base_deces = base_deces %>%
mutate(reponse_deces = factor(reponse_deces, levels = reponse_order))
# FONCTIONS
pct_fr = function(x) {
out = sprintf("%.1f", x)
gsub("\\.", ",", out)
}
count_pct = function(df, group_var){
df %>%
filter(!is.na(.data[[group_var]]), !is.na(reponse_deces)) %>%
count(groupe = .data[[group_var]], reponse = reponse_deces, name = "n") %>%
group_by(groupe) %>%
mutate(pct = 100 * n / sum(n)) %>%
ungroup()
}
n_by = function(df, group_var, levels_vec){
out = df %>%
filter(!is.na(.data[[group_var]]), !is.na(reponse_deces)) %>%
count(val = .data[[group_var]], name = "n") %>%
mutate(val = as.character(val))
sapply(levels_vec, function(lv){
v = out$n[out$val == lv]
if(length(v) == 0) 0 else v[1]
})}
# TABLEAUX DECES
make_table_total_genre_tabac = function(df){
n_total = nrow(df %>% filter(!is.na(reponse_deces)))
n_genre = n_by(df, "genre", c("Femme", "Homme", "NSP"))
n_tabac = n_by(df, "statut_tabac", c("Fumeur", "Non-fumeur", "Ex-fumeur"))
tab_total = df %>%
count(reponse = reponse_deces, name = "n") %>%
mutate(pct = 100 * n / sum(n), groupe = "Total")
tab_genre = count_pct(df, "genre")
tab_tabac = count_pct(df, "statut_tabac")
list(
n_total = n_total,
n_genre = n_genre,
n_tabac = n_tabac,
tab_total = tab_total,
tab_genre = tab_genre,
tab_tabac = tab_tabac )}
make_table_statut2 = function(df){
n_stat = n_by(df, "statut_2", c("Etudiants", "Personnels"))
tab_stat = count_pct(df, "statut_2")
list(n_stat = n_stat,tab_stat = tab_stat
)}
# GLOBAL
df_global = base_deces
deces_global_total_genre_tabac = make_table_total_genre_tabac(df_global)
deces_global_statut2 = make_table_statut2(df_global)
# PAR CAMPUS
deces_campus_results = list()
for(cp in campus_order){
df_cp = base_deces %>% filter(campus == cp)
deces_campus_results[[cp]] = list(
total_genre_tabac = make_table_total_genre_tabac(df_cp),
statut2 = make_table_statut2(df_cp)
)}
# Affichage tableaux
deces_global_total_genre_tabac
deces_global_statut2
deces_campus_results
#  GRAPHE DECES
plot_df_deces = bind_rows(
df_global %>% mutate(campus_plot = "Global"),
base_deces %>% mutate(campus_plot = campus)
) %>%
filter(campus_plot %in% c("Global", campus_order)) %>%
mutate(campus_plot = factor(campus_plot, levels = c("Global", campus_order))) %>%
count(campus_plot, reponse_deces, name = "n") %>%
group_by(campus_plot) %>%
mutate(pct = n / sum(n)) %>%
ungroup()
plot_deces = ggplot(plot_df_deces, aes(x = campus_plot, y = pct, fill = reponse_deces)) +
geom_col(width = 0.75) +
geom_text(
aes(label = paste0(round(pct * 100, 1), " %")),
position = position_stack(vjust = 0.5),
size = 3.8,
color = "black"
) +
scale_y_continuous(
labels = percent_format(accuracy = 1),
limits = c(0, 1)
) +
labs(
title = "Deces prématurés du tabac en France
” Répartition des réponses (Global + campus)",
x = NULL,
y = "Pourcentage",
fill = NULL
) +
theme_minimal(base_size = 13) +
theme(
plot.title = element_text(face = "bold", hjust = 0.5),
axis.text.x = element_text(face = "bold")
)
plot_deces
# ENDROITS OU LES PERSONNES FUMENT
donnees = donnees_a
var_campus ="quel_est_votre_etablissement_de_rattachement"
var_genre = "etes_vous"
var_fume = "vous_arrive_t_il_de_fumer"
var_deja = "avez_vous_deja_fume"
vars_endroits = c(
"quels_sont_les_endroits_de_votre_campus_ou_les_personnes_fument_entrees_des_batiments",
"quels_sont_les_endroits_de_votre_campus_ou_les_personnes_fument_abris_a_velos_ou_a_proximite",
"quels_sont_les_endroits_de_votre_campus_ou_les_personnes_fument_parking",
"quels_sont_les_endroits_de_votre_campus_ou_les_personnes_fument_espaces_verts_de_loisir_et_detente",
"quels_sont_les_endroits_de_votre_campus_ou_les_personnes_fument_autre"
)
labels_endroits = c(
"Entrees des batiments",
"Abris a  vélos",
"Parking",
"Espaces verts",
"Autre"
)
names(labels_endroits) = vars_endroits
genre_levels = c("Femme", "Homme", "NSP")
tabac_levels = c("Fumeur", "Non-fumeur", "Ex-fumeur")
donnees= donnees %>%
mutate(
campus = str_squish(as.character(.data[[var_campus]])),
campus = recode(
campus,
"UniversitÃ© de Caen Normandie (IUT, Antenne de droit, INSPE)" = "UNICAEN"
),
genre = case_when(
str_detect(str_to_lower(.data[[var_genre]]), "femme") ~ "Femme",
str_detect(str_to_lower(.data[[var_genre]]), "homme") ~ "Homme",
TRUE ~ "NSP"
),
genre = factor(genre, levels = genre_levels),
fume = str_detect(str_to_lower(.data[[var_fume]]), "^oui"),
deja = .data[[var_deja]] == "Oui",
statut_tabac = case_when(
fume ~ "Fumeur",
!fume & deja ~ "Ex-fumeur",
TRUE ~ "Non-fumeur"
),
statut_tabac = factor(statut_tabac, levels = tabac_levels)
)
campus_levels = sort(unique(na.omit(donnees$campus)))
is_checked = function(x){
if (is.logical(x)) return(isTRUE(x))
if (is.numeric(x)) return(!is.na(x) & x == 1)
if (is.character(x)) {
x = str_to_lower(str_trim(x))
return(x %in% c("oui", "1", "true", "vrai", "x"))
}
FALSE
}
df_long = donnees %>%
select(all_of(vars_endroits), campus, genre, statut_tabac) %>%
pivot_longer(
cols = all_of(vars_endroits),
names_to = "var",
values_to = "val"
) %>%
mutate(
coche = vapply(val, is_checked, logical(1)),
endroit = recode(var, !!!labels_endroits),
endroit = factor(endroit, levels = labels_endroits)
)
# GLOBAL
tab_global = df_long %>%
filter(coche == TRUE) %>%
count(endroit) %>%
complete(endroit = labels_endroits, fill = list(n = 0)) %>%
mutate(
endroit = factor(endroit, levels = labels_endroits),
pct = round(100 * n / nrow(donnees), 1)
)
tab_global
# GLOBAL selon le GENRE
tab_global_genre = df_long %>%
filter(coche == TRUE) %>%
count(endroit, genre) %>%
complete(
endroit = labels_endroits,
genre = genre_levels,
fill = list(n = 0)
) %>%
group_by(genre) %>%
mutate(pct = round(100 * n / sum(n), 1)) %>%
ungroup() %>%
mutate(endroit = factor(endroit, levels = labels_endroits))
tab_global_genre
# GLOBAL  selon le statut tabagique
