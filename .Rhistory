tab_campus_tabac
# Tests du khi deux
endroits_tests = donnees %>%
select(all_of(vars_endroits), genre, statut_tabac, campus) %>%
mutate(across(all_of(vars_endroits), ~ ifelse(is_checked(.), 1, 0)))
p_genre = sapply(vars_endroits, function(v){
chisq.test(
table(endroits_tests[[v]], endroits_tests$genre),
simulate.p.value = TRUE
)$p.value
})
p_tabac = sapply(vars_endroits, function(v){
chisq.test(
table(endroits_tests[[v]], endroits_tests$statut_tabac),
simulate.p.value = TRUE
)$p.value
})
p_campus = sapply(vars_endroits, function(v){
chisq.test(
table(endroits_tests[[v]], endroits_tests$campus),
simulate.p.value = TRUE
)$p.value
})
pvalues = data.frame(
endroit = labels_endroits,
p_genre = round(p_genre, 4),
p_tabac = round(p_tabac, 4),
p_campus = round(p_campus, 4)
)
pvalues
