mutate(
n_txt   = as.character(n),
pct_txt = gsub("\\.", ",", sprintf("%.1f", pct))
) %>%
select(bloc, modalite, statut_col, n_txt, pct_txt) %>%
pivot_wider(
names_from  = statut_col,
values_from = c(n_txt, pct_txt),
values_fill = "",
names_expand = TRUE
)
# =====================================================
# 9) Renommer proprement
# =====================================================
tab_wide2 <- tab_wide %>%
rename(
n_total = n_txt_Total,          p_total = pct_txt_Total,
n_app   = n_txt_Apprenant,      p_app   = pct_txt_Apprenant,
n_prof  = n_txt_Professionnel,  p_prof  = pct_txt_Professionnel,
n_autres = n_txt_Autres,        p_autres = pct_txt_Autres
)
# =====================================================
# 10) Ordonner les modalités
# =====================================================
tab_wide2 <- tab_wide2 %>%
mutate(
bloc = factor(bloc, levels = c("Genre", "Démographie", "Présence sur le campus")),
modalite = case_when(
bloc == "Genre" ~ as.character(factor(
modalite,
levels = c("Femme","Une femme","Homme","Un homme","Je ne souhaite pas répondre à cette question")
)),
bloc == "Démographie" ~ as.character(factor(
modalite,
levels = c("Entre 19 et 25 ans","Entre 26 et 50 ans","Entre 51 et 69 ans")
)),
TRUE ~ as.character(modalite)
)
) %>%
arrange(bloc, modalite)
View(tab_wide2)
